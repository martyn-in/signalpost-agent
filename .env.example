# Signalpost Environment Configuration Example
# All credentials are completely OPTIONAL. The default agent runs with $0 external cost.

# User-Agent header for polite outbound HTTP requests
HTTP_USER_AGENT=SignalpostAgent/1.0 (+https://builderr.ai/challenges/signalpost; bot@builderr.ai)

# Optional search provider for candidate domain discovery (e.g. Brave Search API)
# SEARCH_API_KEY=your_brave_search_api_key_here

# Optional LLM API credentials for extended natural-language profile briefs
# LLM_API_KEY=your_openai_or_gemini_api_key_here
# LLM_MODEL=gpt-4o-mini

# Concurrency and timeout limits
MAX_CONCURRENCY=12
CACHE_DIR=data/cache
LOG_LEVEL=INFO
